# Python
__pycache__/
*.py[cod]
venv/
.venv/
latent-env/
*.egg-info/

# Datasets are downloaded on first run and NOT committed.
data/

# Trained weights (produced by train.py) CAN be committed so others run offline
# without retraining -- each .pt bakes in its latent map. Commit them explicitly:
#   git add models/*.pt
# Ignore everything else under models/ (e.g. the empty dir / scratch files).
models/*
!models/*.pt

# Gradio / misc
flagged/
.gradio/
*.log
